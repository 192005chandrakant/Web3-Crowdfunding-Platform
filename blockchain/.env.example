# ==========================================
# BLOCKCHAIN MODE SELECTOR
# 'local'  -> Ganache / Hardhat node
# 'rpc'    -> Polygon Amoy via Alchemy (ACTIVE)
# ==========================================
BLOCKCHAIN_MODE=rpc

# ── Polygon Amoy Testnet via Alchemy ──────────────────────────────────────────
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CHAIN_ID=80002

# ── Local Ganache (LOCAL mode only) ───────────────────────────────────────────
LOCAL_RPC_URL=http://127.0.0.1:7545
LOCAL_CHAIN_ID=1337

# ── Deployer wallet ───────────────────────────────────────────────────────────
# Fund with test POL from https://faucet.polygon.technology/
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# ── Legacy Ganache key (LOCAL mode) ───────────────────────────────────────────
GANACHE_RPC_URL=http://127.0.0.1:8545
GANACHE_PRIVATE_KEY=your_ganache_funded_account_private_key

# ── Deployed contracts (auto-populated by deploy script) ──────────────────────
# FACTORY_CONTRACT_ADDRESS=0xYourDeployedFactoryAddressHere

# ── Optional: PolygonScan contract verification ────────────────────────────────
# POLYGONSCAN_API_KEY=your_polygonscan_api_key
