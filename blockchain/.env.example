# Polygon Amoy testnet (chain ID 80002) — development deployment
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/your_key

# Deployer wallet (never commit real keys)
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Optional: local Ganache for unit tests
# Use chain ID 1337 on port 7545 with npm run deploy:ganache / test:ganache.
# Use chain ID 80002 on port 8545 with npm run deploy:ganache-amoy / test:ganache-amoy.
GANACHE_RPC_URL=http://127.0.0.1:7545
# GANACHE_RPC_URL=http://127.0.0.1:8545
