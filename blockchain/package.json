{
  "name": "crowdfunding-blockchain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test --network ganache",
    "test:ganache": "hardhat test --network ganache",
    "test:ganache-amoy": "hardhat test --network ganache_amoy_local",
    "deploy:ganache": "hardhat run scripts/deploy.js --network ganache",
    "deploy:ganache-amoy": "hardhat run scripts/deploy.js --network ganache_amoy_local",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network polygon_amoy"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^6.2.2",
    "ethers": "^5.7.2",
    "ganache": "^7.9.2",
    "hardhat": "^2.22.7"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
