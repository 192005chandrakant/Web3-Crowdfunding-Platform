# Backend API Configuration
VITE_BACKEND_URL=http://localhost:5000

# Blockchain Configuration
VITE_FACTORY_CONTRACT_ADDRESS=0x...
VITE_TARGET_CHAIN_ID=1337
# 1337 = Local Ganache (default for local dev)
# 80002 = Polygon Amoy Testnet
# 137 = Polygon Mainnet
# 1 = Ethereum Mainnet

# RPC Provider (Alchemy recommended)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here
VITE_ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Local Ganache RPC (used when developing locally)
VITE_GANACHE_RPC_URL=http://127.0.0.1:8545

# WalletConnect (required for mobile wallet connections)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional: GraphQL Endpoint (if using Apollo Client)
VITE_GRAPHQL_URL=http://localhost:5000/graphql

# Optional: IPFS Gateway (default: Pinata public gateway)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional: Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Optional: Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_TESTNET_FAUCET=true
