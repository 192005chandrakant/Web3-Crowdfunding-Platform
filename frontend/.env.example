# ==========================================
# BLOCKCHAIN MODE SELECTOR
# 'local'  -> Ganache / Hardhat node
# 'rpc'    -> Polygon Amoy via Alchemy (ACTIVE)
# ==========================================
VITE_BLOCKCHAIN_MODE=rpc

# ── Polygon Amoy Testnet via Alchemy ──────────────────────────────────────────
VITE_ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
VITE_TARGET_CHAIN_ID=80002
VITE_CHAIN_ID=80002

# ── Local Ganache (LOCAL mode only) ───────────────────────────────────────────
VITE_GANACHE_RPC_URL=http://127.0.0.1:7545

# ── Backend & GraphQL ─────────────────────────────────────────────────────────
VITE_GRAPHQL_ENDPOINT=http://localhost:5000/graphql
VITE_BACKEND_URL=http://localhost:5000

# ── Clerk Auth ────────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ── Deployed contracts (filled automatically by deploy script) ────────────────
VITE_FACTORY_CONTRACT_ADDRESS=0xYourDeployedFactoryAddressHere

# ── Admin wallets ─────────────────────────────────────────────────────────────
VITE_ADMIN_WALLET_ADDRESSES=0xWallet1,0xWallet2
