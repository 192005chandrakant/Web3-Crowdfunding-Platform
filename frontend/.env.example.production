# ==============================================================================
# MILESTONECHAIN FRONTEND — PRODUCTION ENVIRONMENT TEMPLATE (VERCEL)
# Copy these values into your Vercel Project Settings > Environment Variables
# Do NOT commit actual secrets or private keys to source control.
# ==============================================================================

# ── Blockchain Mode & Target Network ──────────────────────────────────────────
# 'rpc' enables live testnet/mainnet communication via Alchemy
VITE_BLOCKCHAIN_MODE=rpc
VITE_TARGET_CHAIN_ID=80002
VITE_CHAIN_ID=80002

# ── Alchemy RPC Endpoint ──────────────────────────────────────────────────────
# Dedicated HTTPS RPC URL from Alchemy dashboard (e.g. Polygon Amoy or Mainnet)
VITE_ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ── Backend API & GraphQL Endpoints ───────────────────────────────────────────
# Point to your production Render backend (must use https:// with no trailing slash)
VITE_BACKEND_URL=https://your-backend-service.onrender.com
VITE_GRAPHQL_ENDPOINT=https://your-backend-service.onrender.com/graphql

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Production or staging Clerk publishable key from Clerk Dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ── Deployed Smart Contracts ──────────────────────────────────────────────────
# Deployed CampaignFactory and Implementation addresses on Polygon Amoy
VITE_FACTORY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_IMPL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Platform Administrators ───────────────────────────────────────────────────
# Comma-separated EVM wallet addresses authorized for admin controls
VITE_ADMIN_WALLET_ADDRESSES=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002

