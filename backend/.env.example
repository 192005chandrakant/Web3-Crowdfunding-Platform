# ==========================================
# BLOCKCHAIN MODE SELECTOR
# 'local'  -> Ganache / Hardhat node
# 'rpc'    -> Polygon Amoy via Alchemy (ACTIVE IN PRODUCTION)
# ==========================================
BLOCKCHAIN_MODE=rpc

# ── Polygon Amoy Testnet via Alchemy (Active in Production) ───────────────────
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CHAIN_ID=80002

# ── Local Ganache (LOCAL mode only) ───────────────────────────────────────────
LOCAL_RPC_URL=http://127.0.0.1:7545
LOCAL_CHAIN_ID=1337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# ── Deployer wallet ───────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# ── Deployed contracts ────────────────────────────────────────────────────────
# Live Polygon Amoy Factory: 0x4B3E9091e8A15AdcC8fcC1FCC7D6D273F4Cc2D01
CAMPAIGN_FACTORY_ADDRESS=0x4B3E9091e8A15AdcC8fcC1FCC7D6D273F4Cc2D01
CAMPAIGN_IMPL_ADDRESS=0xaC0ddA015c57407369033652e9a026c3021cb680

# ── Server & CORS ─────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=AppName
# Comma-separated list of allowed origins (Vercel *.vercel.app subdomains and onrender.com are auto-allowed)
ALLOWED_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000
FRONTEND_URL=https://your-frontend.vercel.app

# ── Pinata IPFS ───────────────────────────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
CACHE_TTL_SECONDS=300

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Clerk Auth ────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret

# ── Security ──────────────────────────────────────────────────────────────────
WEBHOOK_API_KEY=your_random_webhook_secret
ADMIN_WALLET_ADDRESSES=0xWallet1,0xWallet2
