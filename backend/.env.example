PORT=5000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:3002
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas (metadata cache)
MONGODB_URI=mongodb+srv://
# Polygon Amoy testnet (development default)
CHAIN_ID=80002
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/your_key

# Pinata IPFS (milestone proofs)
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt_if_used

# Upstash Redis (response cache)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
CACHE_TTL_SECONDS=300

# Cloudinary (campaign cover images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (transactional email notifications)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Clerk (optional server-side auth hooks)
CLERK_SECRET_KEY=your_clerk_secret_key

# Webhook API key (for blockchain event ingestion)
WEBHOOK_API_KEY=your_secure_webhook_api_key

# Admin wallet addresses (comma-separated, for admin route access)
ADMIN_WALLET_ADDRESSES=0xYourAdminWalletAddress
