# ==============================================================================
# MILESTONECHAIN BACKEND — PRODUCTION ENVIRONMENT TEMPLATE (RENDER)
# Add these key-value pairs into your Render Dashboard > Environment Variables
# Do NOT commit actual secrets, database passwords, or private keys to source control.
# ==============================================================================

# ── Runtime & Port ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Blockchain Mode & Network ─────────────────────────────────────────────────
# 'rpc' enables live testnet/mainnet event processing via Alchemy
BLOCKCHAIN_MODE=rpc
CHAIN_ID=80002
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ── Smart Contract Addresses ──────────────────────────────────────────────────
# Deployed Factory and Implementation addresses on Polygon Amoy
CAMPAIGN_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
CAMPAIGN_IMPL_ADDRESS=0x0000000000000000000000000000000000000000

# ── Backend Signer / Deployer Wallet ──────────────────────────────────────────
# EVM private key without 0x prefix for server-side transactions (keep secure)
DEPLOYER_PRIVATE_KEY=your_production_deployer_private_key_without_0x_prefix
BLOCKCHAIN_PRIVATE_KEY=your_production_deployer_private_key_without_0x_prefix

# ── Database & CORS ───────────────────────────────────────────────────────────
# MongoDB Atlas connection string with username, password, and database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/milestonechain?retryWrites=true&w=majority
# Comma-separated list of allowed origins (*.vercel.app subdomains are auto-allowed)
ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app,http://localhost:5173,http://localhost:3000
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ── Pinata Decentralized IPFS Storage ─────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt_token

# ── Upstash Serverless Redis Cache ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
CACHE_TTL_SECONDS=300

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Resend Transactional Email Service ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev for test mode, or your verified domain in production
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Clerk Authentication ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# ── Webhook & Admin Security ──────────────────────────────────────────────────
# Secure random hex string for x-api-key authentication on webhook ingestion
WEBHOOK_API_KEY=your_secure_random_webhook_api_key_32_bytes
# Comma-separated EVM wallet addresses authorized for admin controls
ADMIN_WALLET_ADDRESSES=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002
